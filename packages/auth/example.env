# Copy to packages/auth/.env and fill in values.
# Used when NextAuth is configured in this package.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Optional OAuth providers (uncomment when needed)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=
