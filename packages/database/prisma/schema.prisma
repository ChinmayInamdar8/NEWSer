// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  REPORTER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Normal members sign in with Google. Reporter onboarding is a later,
/// separate flow that promotes an existing USER (role stays USER until then).
model User {
  id          String     @id @default(cuid())
  email       String     @unique
  googleId    String?    @unique
  name        String?
  image       String?
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastLoginAt DateTime?

  UserPrefrence UserPrefrence[] 
}

model Preference{
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  is_active Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  UserPrefrence UserPrefrence[]

  @@index([name])
  @@index([id])
}

model UserPrefrence{
  id String @id @default(cuid())
  userId String
  preferenceId String

  createdAt DateTime @default(now())

  User User @relation(fields: [userId], references: [id])
  Preference Preference @relation(fields: [preferenceId], references: [id])

  @@index([userId, preferenceId])
}
