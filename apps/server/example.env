# Copy to apps/server/.env and fill in values.

PORT=4000
NODE_ENV=development

# Public origins allowed by CORS and used after Google redirects back
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Sign session JWTs (httpOnly cookie). Use a long random string.
JWT_SECRET=

# Only this Google account can use the admin app
ADMIN_EMAIL=

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
